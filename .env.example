# FMRAG environment variables
# Copy to /etc/fmrag/env and fill in your values.
# Two roles: central (broker + FL server) and client (hospital edge device).

# ── Node identity ──────────────────────────────────────────────────────────────
FMRAG_NODE_ROLE=client
FMRAG_NODE_IP=192.168.1.10
FMRAG_CENTRAL_IP=172.16.24.34

# ── CPU mode (set explicitly for edge devices without GPU) ─────────────────────
FMRAG_CPU_MODE=true               # forces CPU mode regardless of hardware

# ── CPU performance tuning ──────────────────────────────────────────────────────
FMRAG_LOCAL_EPOCHS=1              # 1 epoch on CPU = 15-45 min on demo data
FMRAG_BATCH_SIZE=4                # 4 = ~2 GB RAM, 8 = ~4 GB RAM
FMRAG_GRAD_ACCUM=4                # effective batch = BATCH_SIZE × GRAD_ACCUM
FMRAG_EWC_SAMPLES=50             # EWC Fisher estimation samples
FMRAG_MODEL_NAME=distilbert-base-uncased   # lighter model for CPU

# ── Database ───────────────────────────────────────────────────────────────────
FMRAG_DB_HOST=localhost
FMRAG_DB_USER=fmrag
FMRAG_DB_PASS=FmragSecure2024!
FMRAG_DB_NAME=fmrag

# ── VMware (client nodes only) ─────────────────────────────────────────────────
FMRAG_VM_STORE=/var/fmrag/vms
FMRAG_OVA_UPLOAD=/var/www/html/uploads
VMRUN_BIN=/usr/lib/vmware/bin/vmrun
OVFTOOL_BIN=/usr/bin/ovftool
VMWARE_TYPE=ws
FMRAG_BRIDGE_IFACE=ens33
FMRAG_VM_USER=fmrag
FMRAG_VM_PASS=

# ── FL server ──────────────────────────────────────────────────────────────────
FMRAG_FL_PORT=9996

# ── Polling ────────────────────────────────────────────────────────────────────
FMRAG_POLL_INTERVAL=30
FMRAG_BROKER_POLL=30

# ── Monitor ────────────────────────────────────────────────────────────────────
FMRAG_SECRET_KEY=change-me-in-production

# ── Python path ────────────────────────────────────────────────────────────────
PYTHONPATH=/opt/fmrag-project/FMRAG
