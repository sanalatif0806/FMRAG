	rdfs:subClassOf <http://purl.bioontology.org/ontology/ICD9CM/E916-E928.9> ;
	<http://purl.bioontology.org/ontology/ICD9CM/SOS> """Excludes: injury caused by: {cutting or piercing instrument (E920.0-E920.9); machinery (E919.0-E919.9); transport vehicle (E800.0-E845.9); vehicle not elsewhere classifiable (E846-E848); mechanism or component of firearm and air gun (E928.7)}; struck accidentally by: {falling object (E916); object (moving) (projected) (E917.0-E917.9)}"""^^xsd:string ;
	<http://purl.bioontology.org/ontology/ICD9CM/ICE> """Caught, crushed, jammed, or pinched in or between moving or stationary objects, such as: {escalator; folding object; hand tools, appliances, or implements; sliding door and door frame; under packing crate; washing machine wringer}"""^^xsd:string ;
	umls:cui """C1278558"""^^xsd:string ;
	umls:tui """T037"""^^xsd:string ;
	umls:hasSTY <http://purl.bioontology.org/ontology/STY/T037> ;
 .

